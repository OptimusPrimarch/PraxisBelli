  <sharedRules>
    <rule name="Wrathbound" id="7ac3-01a0-cc05-a14f" hidden="false">
      <description>This unit rerolls failed damage rolls in melee</description>
    </rule>
    <rule name="Tithe of Skulls" id="1d23-a098-0b93-3eb7" hidden="false">
      <description>This unit ignores suppression markers when making Morale tests. If there is an eligible charge available to this unit, it must make it. When this unit destroys an enemy unit in melee, it has paid its tithe and gains `Extra Hits 8+` in melee for the remainder of the game.</description>
    </rule>
  </sharedRules>
