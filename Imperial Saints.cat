  <sharedRules>
    <rule name="Martyrs, All" id="33e3-3e30-8208-b5c4" hidden="false">
      <description>When this unit falls below half its starting total wounds, it enters martyrdom. When a unit enters martyrdom, it immediately discards all suppression markers it has. While in martyrdom, reroll failed morale tests and damage rolls.</description>
    </rule>
  </sharedRules>
